<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JSMovie2"
        mc:Ignorable="d"
        Title="JSMovie2 V2.00" Height="768" Width="1300">
    <Grid Margin="0,0,3.6,0.2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="39.25"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!--
        ボタン配置場所
        -->
        <ComboBox x:Name="CB_競技会" Grid.Column="0" Grid.Row="1" Width="172" Height="40" VerticalAlignment="Top"  Margin="10,31.6,18,0" SelectionChanged="CB_競技会_SelectionChanged" />
        <ComboBox x:Name="CB_区分" Grid.Column="0" Grid.Row="1" Width="172" Height="40" VerticalAlignment="Top" Margin="10,86.6,18,0" SelectionChanged="CB_区分_SelectionChanged" />
        <ComboBox x:Name="CB_ラウンド" Grid.Column="0" Grid.Row="1" Width="172" Height="40" VerticalAlignment="Top" Margin="10,140.6,18,0" SelectionChanged="CB_ラウンド_SelectionChanged" />

        <ScrollViewer Name="SCV_List" Background="Aqua"  Margin="0,200,0,0"   Grid.Column="0" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" >
            <UniformGrid Name="uniformGrid2" Background="Yellow" Margin="0,0,0,0" Height="Auto"  Width="Auto" Columns="1" Rows="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
            </UniformGrid>
        </ScrollViewer>

        <!--
        映像表示配置場所   録画用  (WriteableBitmapで描画)
        -->
        <ScrollViewer Name="SCV_Screen" Background="Gray"  Margin="0,0,0,0" Grid.Column="1" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Hidden" >
            <Image x:Name="Img_Screen" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </ScrollViewer>

        <!--
        映像表示配置場所   再生用
        -->
        <ScrollViewer Name="SCV_Screen_Play" Background="Black"  Margin="0,0,0,0" Grid.Column="1" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Visible" >
            <MediaElement  x:Name="MediaElementMovie"  Stretch="Fill" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                           MouseWheel="MediaElementMovie_MouseWheel"
                           MouseLeftButtonDown="MediaElementMovie_MouseLeftButtonDown"
                           MouseLeftButtonUp="MediaElementMovie_MouseLeftButtonUp"
                           MouseMove="MediaElementMovie_MouseMove"
                           />
        </ScrollViewer>

        <!--
        Re-Connectボタン
        -->
        <Button Name="PB_Reconnect" Content="Re-Connect" Click="ReConnect" Margin="0,0,0,0.4" Grid.Column="0" Grid.Row="1" Grid.RowSpan="3" FontSize="24" Height="79" VerticalAlignment="Bottom" />

        <!--
        コントロールボタン配置場所 Record用
        -->
        <ScrollViewer Name="SCV_REC_Control" Background="Beige"  Margin="0,0,0,0" Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Hidden" >
            <UniformGrid Name="uniformGrid3" Background="Aqua" Columns="0" Rows="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" >
                <Button x:Name="PB_録画開始" Content="録画開始" Margin="0,0,0,0" FontSize="24" Height="70" Width="200" />
                <Label x:Name="LB_タイマー" Content="00:00"  BorderThickness="10" Background="#FF09C592" Width="200"  FontSize="40"   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinHeight="83" HorizontalAlignment="Right"/>
            </UniformGrid>
        </ScrollViewer>

        <!--
        コントロールボタン配置場所 PLAY用　1行目スクロールバー
        -->
        <Grid Name="Grid_Play_SCBar" Grid.Column="1" Grid.Row="2" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="19.25" />
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <Slider Name="SliderMoviePosition" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Width="auto"
                     ValueChanged="SliderMoviePosition_ValueChanged" Minimum="0" Maximum="100" />
            <Canvas x:Name="Canvas_BM" HorizontalAlignment="Stretch" Height="19"  VerticalAlignment="Bottom" Grid.ColumnSpan="3" Grid.RowSpan="2" Background="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}" Width="auto" />
            <Label x:Name="LB_Total時間" Content="00:00"  Grid.Row="1"  Grid.Column="2" FontSize="14" HorizontalContentAlignment="Right" Margin="0,-6,0,0" Width="auto"  />
            <Label x:Name="LB_経過時間" Content="00:00" Grid.Column="0"  Grid.Row="1" FontSize="14" Margin="0,-6,0,0" />
        </Grid>

        <!--
        コントロールボタン配置場所 PLAY用　2行目ボタン類
        -->
        <ScrollViewer Name="SCV_PLAY_Control" Background="Beige"  Margin="0,0,0,0" Grid.Column="1" Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Visible" >
            <StackPanel Name="uniformGrid_play" Orientation="Horizontal" Background="Aqua"  HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="Auto" Height="40" >
                <Button x:Name="PB_再生" Content="▶Play"   Click="ButtonPlay_Click"  Margin="0,0,0,0"   FontSize="24" Height="38" Width="120" />
                <Button x:Name="PB_スロー" Content="▷▷x0.5"  Click="ButtonSlow_Click"  Margin="0,1"   FontSize="24" Height="38" Width="110" />
                <Button x:Name="PB_コマ戻り" Content="II◀"   Click="Buttonコマ戻り_Click"  Margin="0,0,0,0"   FontSize="24" Height="38" Width="83" />
                <Button x:Name="PB_一時停止" Content="II Pause"  Click="ButtonPause_Click"  Margin="0,1"   FontSize="24" Height="38" Width="115" />
                <Button x:Name="PB_コマ送り" Content="▶II"    Click="Buttonコマ送り_Click" Margin="0,0,0,0"   FontSize="24" Height="38" Width="83" />
                <Button x:Name="PB_早送り" Content="▶▶x2"    Click="Button早送り_Click" Margin="0,1"   FontSize="24" Height="38" Width="101" />
                <Button x:Name="PB_停止" Content="■ Stop"   Click="ButtonStop_Click"  Margin="0,0,0,0"   FontSize="24" Height="38" Width="127" />
                <Button x:Name="PB_サイズ" Content="□ORG Size"   Click="ButtonORGSize_Click"  Margin="0,1"   FontSize="24" Height="38" Width="169" />
            </StackPanel>
        </ScrollViewer>

        <!--
        ヘッダー
        -->
        <ScrollViewer Name="SCV_REC_Hedder" Background="Blue"  Margin="0,0,0,0" Grid.Column="1" Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"  >
            <Grid Name="Grid_Hedder" Background="Black" Margin="0,0,0,0" Height="106"  Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                <Label Name="LB_Hedder" Content="種目　ヒート　背番号　名前" Foreground="White" FontSize="24"/>
                <Label x:Name="LB_Status" Content="Recording"  FontSize="26"  BorderThickness="10" Background="Red" Width="200"   HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  HorizontalAlignment="Right" Height="60" Visibility="Hidden" Margin="0,10,23.6,36"/>
                <Label x:Name="LB_FPS" Content="" Foreground="White" FontSize="24" Margin="0,22,228.6,44" Width="92"  VerticalContentAlignment="Center" HorizontalAlignment="Right"  />
            </Grid>
        </ScrollViewer>

        <TextBlock Name="TB_CompName"  Text="未接続" TextWrapping="Wrap"  Margin="0,0,0,0.4" HorizontalAlignment="Left" Width="195" FontSize="14"/>
        <Button Name="PB_Refresh"  Content="Refresh" HorizontalAlignment="Left"  Margin="107,7.6,0,0" Grid.Row="1" VerticalAlignment="Top" Width="75" />

    </Grid>
</Window>
