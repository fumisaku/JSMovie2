<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>JSMovie2</RootNamespace>
    <AssemblyName>JSMovie2</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <MyType>WPF</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,42314</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 音声録音 (NAudio 2.x は .NET 8 で netstandard2.0 が使える) -->
    <PackageReference Include="NAudio" Version="2.2.1" />

    <!-- JSON シリアライズ -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- カメラキャプチャ (OpenCvSharp4 最新版 - Windows 11 対応) -->
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
  </ItemGroup>

  <!-- .NET 8 SDK スタイルでは My Project 配下の自動生成ファイルは不要 -->
  <ItemGroup>
    <Compile Remove="My Project\Resources.Designer.vb" />
    <Compile Remove="My Project\Settings.Designer.vb" />
    <EmbeddedResource Remove="My Project\Resources.resx" />
    <None Remove="My Project\Settings.settings" />
    <None Remove="packages.config" />
    <None Remove="App.config" />
  </ItemGroup>

</Project>
